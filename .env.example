# ═══════════════════════════════════════════════════════════════════════════
# CVForms — ambiente de desenvolvimento
#
# Copia para `.env` e ajusta. O `.env` está no .gitignore e NUNCA vai para o
# repositório (ESPECIFICACAO.md §8, restrição 9).
#
# Em produção nada disto vem de ficheiro: vem do ambiente da plataforma
# (Railway, Vercel) ou de um gestor de segredos.
# ═══════════════════════════════════════════════════════════════════════════

# ─── Base de dados ─────────────────────────────────────────────────────────
# Aponta para o Postgres do docker-compose (`pnpm infra:up`).
# Porto em que o Postgres do compose fica exposto na máquina. Muda-o se já
# tiveres um Postgres a ocupar o 5432 — e muda a DATABASE_URL a condizer.
POSTGRES_PORT=5432
DATABASE_URL=postgres://cvforms:cvforms@localhost:5432/cvforms
# O pool da API é pequeno de propósito: a carga de sincronização passa pelo
# PowerSync, não por aqui.
DATABASE_POOL_MAX=10
DATABASE_SSL=false

# ─── API ───────────────────────────────────────────────────────────────────
PORT=4000
HOST=0.0.0.0
NODE_ENV=development
LOG_LEVEL=info
# Origens autorizadas do painel, separadas por vírgula.
CORS_ORIGINS=http://localhost:3000

# ─── Keycloak ──────────────────────────────────────────────────────────────
# URL do realm, não do servidor. É daqui que sai o JWKS que valida os tokens.
KEYCLOAK_ISSUER=http://localhost:8080/realms/cvforms
# Audiências aceites pela API, separadas por vírgula.
KEYCLOAK_AUDIENCE=cvforms-mobile,cvforms-admin,cvforms-api
# Tolerância de relógio, em segundos. Existe porque os telefones de campo
# desacertam e um técnico não pode ficar sem trabalhar por causa disso.
# O custo é uma janela curta em que um token acabado de expirar ainda passa.
JWT_CLOCK_TOLERANCE_S=120

# Consola de administração do Keycloak em desenvolvimento: admin / admin
# Utilizadores de demonstração (criados pelo realm importado):
#   admin.demo   / demo
#   tecnico.demo / demo

# ─── Painel de administração (Next.js) ─────────────────────────────────────
NEXTAUTH_URL=http://localhost:3000
# Gera um valor próprio: `openssl rand -base64 32`. Não uses este.
NEXTAUTH_SECRET=troca-me-por-um-valor-gerado
KEYCLOAK_CLIENT_ID=cvforms-admin
# Cliente público com PKCE — não há segredo. Deixa vazio.
KEYCLOAK_CLIENT_SECRET=
# Onde o painel encontra a API (chamada do lado do servidor).
API_URL=http://localhost:4000

# ─── App móvel (Expo) ──────────────────────────────────────────────────────
# ATENÇÃO: tudo o que começa por EXPO_PUBLIC_ fica embutido no pacote da app e
# é legível por quem a descompilar. Só entra aqui o que pode ser público.
#
# 10.0.2.2 é o endereço pelo qual o emulador do Android vê o teu computador.
# Num telefone físico, usa o IP da tua máquina na rede local.
EXPO_PUBLIC_API_URL=http://10.0.2.2:4000
EXPO_PUBLIC_KEYCLOAK_ISSUER=http://10.0.2.2:8080/realms/cvforms
EXPO_PUBLIC_KEYCLOAK_CLIENT_ID=cvforms-mobile
EXPO_PUBLIC_POWERSYNC_URL=http://10.0.2.2:8090

# ─── PowerSync ─────────────────────────────────────────────────────────────
# Usado pelo /health da API para saber se o serviço de sincronização está de
# pé. Vazio = não configurado, e o /health não conta isso como avaria.
POWERSYNC_URL=http://localhost:8090
# A partir de que atraso um slot de replicação passa a aviso no /health. Um
# slot parado impede o Postgres de reciclar o WAL, e o WAL enche o disco
# (ADR-0004, F10.9).
REPLICACAO_ATRASO_ALERTA_MB=1024
# A partir de onde deixa de ser aviso e passa a urgente: /health/replicacao
# responde 503 e o monitor de disponibilidade dispara.
REPLICACAO_ATRASO_CRITICO_MB=8192
# Intervalo da verificação, em segundos. 0 desliga o vigia.
REPLICACAO_VIGIA_S=300

# ─── Relato de erros (F10.6) ───────────────────────────────────────────────
# Vazio = desligado, que é o normal fora de produção. O DSN é um segredo e
# nunca entra no repositório (restrição inegociável 9). Precisa de
# `pnpm add @sentry/node` na API e `@sentry/nextjs` no painel; sem os pacotes
# instalados isto continua a arrancar, só não relata nada.
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0
PS_DATABASE_URI=postgres://cvforms:cvforms@postgres:5432/cvforms
PS_JWKS_URL=http://keycloak:8080/realms/cvforms/protocol/openid-connect/certs
PS_JWT_AUDIENCE=cvforms-mobile
PS_PORT=8090
# Só para as rotas administrativas do próprio serviço. Gera um valor próprio.
PS_ADMIN_TOKEN=troca-me-por-um-valor-gerado

# ─── Armazenamento de anexos (MinIO em dev, R2/S3 em produção) ─────────────
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=cvforms-attachments
S3_ACCESS_KEY_ID=cvforms
S3_SECRET_ACCESS_KEY=cvforms-dev-secret
# O MinIO precisa disto; o R2 e o S3 não.
S3_FORCE_PATH_STYLE=true
