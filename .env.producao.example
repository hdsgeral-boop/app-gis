# ═══════════════════════════════════════════════════════════════════════════
# CVForms em produção.
#
# Copia para `.env.producao` e preenche. Esse ficheiro NÃO entra no
# repositório (restrição inegociável 9) e o `.gitignore` já o exclui.
#
# NENHUM VALOR AQUI SERVE COMO ESTÁ. Todos os segredos estão a `TROCA-ME`
# de propósito: um valor por omissão que funcione é um valor que fica em
# produção. Gera cada um com:
#
#     openssl rand -base64 32
#
# ou, sem openssl à mão:
#
#     node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# ═══════════════════════════════════════════════════════════════════════════

# ── Nomes ──────────────────────────────────────────────────────────────────
# Os cinco têm de apontar para o IP deste servidor ANTES do primeiro arranque.
# Sem isso o Caddy tenta emitir certificados, falha, e fica em espera
# exponencial — o que parece o serviço estar em baixo.
DOMINIO_PAINEL=painel.exemplo.ao
DOMINIO_API=api.exemplo.ao
DOMINIO_SYNC=sync.exemplo.ao
DOMINIO_AUTH=auth.exemplo.ao
DOMINIO_FICHEIROS=ficheiros.exemplo.ao

# Para onde a Let's Encrypt manda os avisos de expiração.
ACME_EMAIL=

# ── Postgres ───────────────────────────────────────────────────────────────
POSTGRES_USER=cvforms
POSTGRES_DB=cvforms
POSTGRES_PASSWORD=TROCA-ME

# O papel com que a API corre. NÃO é o dono das tabelas e NÃO tem BYPASSRLS:
# se a API correr como dono, o isolamento entre organizações desaparece sem
# erro nenhum (ADR-0010). Criado por `infra/scripts/criar-papel-app.sh`.
APP_DB_USER=cvforms_app
APP_DB_PASSWORD=TROCA-ME

# ── Keycloak ───────────────────────────────────────────────────────────────
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=TROCA-ME
# Segredo do cliente `cvforms-admin`, copiado do Keycloak depois do primeiro
# arranque (Clients → cvforms-admin → Credentials).
KEYCLOAK_ADMIN_CLIENT_SECRET=TROCA-ME

# ── Painel ─────────────────────────────────────────────────────────────────
# Assina os cookies de sessão. Trocá-lo põe toda a gente fora, o que às vezes
# é exactamente o que se quer.
NEXTAUTH_SECRET=TROCA-ME

# ── Sincronização ──────────────────────────────────────────────────────────
POWERSYNC_ADMIN_TOKEN=TROCA-ME

# ── Armazenamento ──────────────────────────────────────────────────────────
MINIO_ROOT_USER=cvforms
MINIO_ROOT_PASSWORD=TROCA-ME
S3_BUCKET=cvforms-anexos
# Mosaicos de mapa (PMTiles). Balde separado dos anexos: os mapas são poucos
# ficheiros grandes e partilhados, os anexos são muitos e por organização.
S3_BUCKET_MAPAS=cvforms-mapas

# ── Observabilidade ────────────────────────────────────────────────────────
# Vazio = relato de erros desligado. Ver F10.6.
SENTRY_DSN=
LOG_LEVEL=info
